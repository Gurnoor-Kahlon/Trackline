# Copy to .env and fill in. .env is gitignored and must never be committed.
# docker-compose.yml reads this file automatically.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=trackline
POSTGRES_USER=trackline
# No default is provided on purpose: docker compose fails fast if this is unset.
POSTGRES_PASSWORD=change-me-locally
# Deliberately not 5432: a PostgreSQL installed natively on the machine would
# shadow the container's published port, and connections would silently reach the
# wrong server. This value is used both for the published port and for the API's
# JDBC URL, so changing it here is enough.
POSTGRES_PORT=56432

# --- Redis ---
# Deliberately not 6379, for the same reason POSTGRES_PORT is not 5432: a Redis
# installed natively on the machine will shadow the container's published port,
# and the application then talks to the wrong server with no error to show for it.
# This includes a Redis inside a WSL distro, which Windows relays to localhost.
REDIS_PORT=56379

# --- Accounts (docs/authentication.md) ---
# Signs access tokens. No default on purpose: the API refuses to start without it, since every token would be
# forgeable with a value anyone reading this repository knows. At least 32 bytes; generate one with:
#   openssl rand -base64 48
# A secret changed later signs everyone out, which is the right way to rotate it.
# Left empty on purpose, so copying this file as it is does not give the API a secret that is public.
TRACKLINE_AUTH_JWT_SECRET=


# --- The full stack in containers (docker compose --profile full) ---
# Everything below has a working default and is only needed to change one.
#
# Where the API and the web application are published on this machine.
# API_PORT=8080
# WEB_PORT=3000
#
# Where a BROWSER reaches the API. Written into the web image when it is built, so changing it means building again
# (docker compose --profile full up -d --build). If API_PORT is changed, change this to match.
# PUBLIC_API_URL=http://localhost:8080
#
# The one origin the API allows browsers to call it from: the web application's address, exactly, with no trailing slash.
# If WEB_PORT is changed, change this to match.
# WEB_ORIGIN=http://localhost:3000
