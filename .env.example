# Copy to .env and fill in. .env is gitignored and must never be committed.
# docker-compose.yml reads this file automatically.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=trackline
POSTGRES_USER=trackline
# No default is provided on purpose: docker compose fails fast if this is unset.
POSTGRES_PASSWORD=change-me-locally
# Deliberately not 5432: a PostgreSQL installed natively on the machine would
# shadow the container's published port, and connections would silently reach the
# wrong server. This value is used both for the published port and for the API's
# JDBC URL, so changing it here is enough.
POSTGRES_PORT=55432

# --- Redis ---
# Deliberately not 6379, for the same reason POSTGRES_PORT is not 5432: a Redis
# installed natively on the machine will shadow the container's published port,
# and the application then talks to the wrong server with no error to show for it.
# This includes a Redis inside a WSL distro, which Windows relays to localhost.
REDIS_PORT=56379
