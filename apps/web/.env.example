# Web application configuration. Copy to .env.local to override; every value
# below is a working default, so the file is only needed to change one.
#
# These are NEXT_PUBLIC_, which means they are compiled into the browser bundle
# and are readable by anyone using the site. Nothing secret belongs here.

# Where the Trackline API is served. The browser calls this directly, so in a
# deployed environment it must be the public URL, not an internal hostname.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# The basemap. OpenFreeMap needs no API key and bills nothing, which is what
# makes a public deployment viable; holding both styles in configuration means
# swapping to a paid provider or to self-hosted tiles touches no code.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
