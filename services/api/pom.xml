<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ca.trackline</groupId>
    <artifactId>trackline-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>trackline-api</name>
    <description>Trackline transit intelligence API</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <protobuf.version>4.36.2</protobuf.version>
        <protobuf-maven-plugin.version>5.1.11</protobuf-maven-plugin.version>
        <wiremock.version>3.13.2</wiremock.version>
        <!-- Overridable so the live feed tests can be run deliberately:
             ./mvnw test -Dgroups=live -DexcludedGroups= -->
        <excludedGroups>live</excludedGroups>
    </properties>

    <dependencies>
        <!-- REST controllers and the embedded server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jakarta Validation: request parameter/body validation and @Validated
             on configuration properties, so misconfiguration fails at startup. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health endpoint (the ALB health check in production) and the
             Micrometer registry that ingestion metrics are published to. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI document and Swagger UI generated from the controllers,
             so the API stays documented without a hand-maintained spec. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Authentication: the filter chain, BCrypt password hashing and the method-level rules that keep one
             user out of another's favourites. Every read endpoint stays open; only /auth/me and /favourites
             need a token. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Access tokens are signed JWTs. This brings the Nimbus library that Spring Security's own JwtEncoder and
             JwtDecoder use, so there is no second token library to keep patched and validation (signature,
             expiry, issuer) is the framework's, not hand-written. Nothing here makes this API an OAuth server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- JPA/Hibernate for entity mapping and query execution. Bulk loading in
             the static import milestone uses COPY through the JDBC connection
             rather than persist() per row. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Maps PostGIS geometry/geography columns to JTS types, so spatial
             values are read and written as real geometry rather than WKT strings. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
        </dependency>

        <!-- Redis holds the live snapshot so a page view does not query Postgres for
             positions that change every ten seconds. It is a cache: everything in it
             is reconstructed by the next ingestion cycle, and the API degrades rather
             than fails when it is gone. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Versioned schema migrations; the schema is never generated at runtime. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- The PostgreSQL driver is also a compile dependency: the GTFS import
             uses its CopyManager to stream rows through COPY, which is the only
             practical way to load 4.36 million stop_times. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- GTFS-Realtime is protobuf. The official Java bindings artifact is
             abandoned at 0.0.4 and pins protobuf-java 2.6.1 from 2014, whose
             generated code does not run on a current runtime, so the schema is
             compiled here against a maintained protobuf instead. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- RFC 4180 CSV parsing. GTFS fields are quoted and contain commas
             (stop names in particular), and a hand-rolled splitter would corrupt
             them in ways that are hard to notice. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integration tests run against real PostGIS rather than an in-memory
             database: the spatial queries, index types and migrations this project
             depends on do not exist anywhere else. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Serves recorded feed responses so the ingestion pipeline can be tested
             against timeouts, malformed bodies and server errors without depending
             on the TTC being reachable or misbehaving on cue. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <!-- The standalone build shades its own Jetty. The slim artifact needs
                 Jetty 11 on the classpath, which collides with the server Spring
                 Boot brings. -->
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Tests tagged "live" reach the real TTC feeds. They are excluded from
                 the normal build: a failure caused by someone else's outage would
                 teach nothing, and a build that depends on a third party being up is
                 not a build. Run them deliberately with -Dgroups=live. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Generates the GTFS-Realtime message classes from the vendored
                 official schema. The schema is committed verbatim so it can be
                 diffed against upstream. -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <protoc>${protobuf.version}</protoc>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <!-- Record/DTO constructor parameter names are needed for
                             Jackson binding and clear validation messages. -->
                        <arg>-parameters</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
